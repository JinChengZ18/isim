# Python bytecode and runtime caches
__pycache__/
*.py[cod]
*$py.class
*.nbi
*.nbc

# Test, type-check, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Packaging and build output
build/
dist/
*.egg-info/

# Editor and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch files
*.log
*.tmp
*.bak
*.swp

# EDA regenerable byproducts
# generated ngspice decks
eda/**/_*.spice
# per-run wrdata intermediates (regenerated by every testbench run)
eda/testbenches/_*.csv
# compiled OSDI device model
eda/**/*.osdi
# generated ngspice init file
eda/testbenches/.spiceinit
# magic extraction intermediates
eda/**/*.ext
eda/**/*.res.ext
eda/**/*.sim
eda/**/*.nodes
eda/**/*.al

# PPT figure composition (deck .pptx and final article/figs PNGs are tracked)
# LibreOffice PDF export is regenerable
article/ppt/*.pdf
# letter-free preview composites from figs_make.py
eda/figs_raw/preview_*.png
